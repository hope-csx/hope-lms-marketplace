# HOPE LMS Marketplace tester image.
#
# Published to <product-root>/tester:<version> — see "Registry layout" in
# README.md. Referenced by the
# Marketplace `apptest` verification flow; runs smoke-test.sh against the freshly
# installed release and exits non-zero on failure.
#
# NOTE: keep this tag in sync with MARKETPLACE_TOOLS_TAG in Dockerfile.deployer.
FROM gcr.io/cloud-marketplace-tools/k8s/deployer_helm:13.0.4 AS tools

FROM alpine:3.20
RUN apk add --no-cache bash curl ca-certificates
COPY apptest/tester/smoke-test.sh /tests/smoke-test.sh
RUN chmod +x /tests/smoke-test.sh
ENTRYPOINT ["/tests/smoke-test.sh"]
